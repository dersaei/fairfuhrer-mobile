{
  "expo": {
    "name": "Fairführer+",
    "slug": "fairfuhrer-mobile",
    "scheme": "fairfuhrer",
    "owner": "darsim",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FE6918"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairfuehrer.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:www.fairfuehrer.guide"],
      "infoPlist": {
        "CFBundleDisplayName": "Fairführer+",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"],
        "NSLocationWhenInUseUsageDescription": "Fairführer verwendet deinen Standort, um Orte in deiner Nähe auf der Karte anzuzeigen und die Liste nachhaltiger Orte nach Entfernung zu sortieren (z. B. „in der Nähe von Lindau\"). Ohne Standortfreigabe funktioniert die App weiterhin – lediglich die Nähe-Sortierung ist deaktiviert."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fairfuehrer.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.fairfuehrer.guide",
              "pathPrefix": "/karte"
            },
            {
              "scheme": "https",
              "host": "www.fairfuehrer.guide",
              "pathPrefix": "/impressum"
            },
            {
              "scheme": "https",
              "host": "www.fairfuehrer.guide",
              "pathPrefix": "/agb"
            },
            {
              "scheme": "https",
              "host": "www.fairfuehrer.guide",
              "pathPrefix": "/datenschutz"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "feab62c4-b204-4da1-a5f2-34d240a5b139"
      }
    },
    "plugins": [
      "@rnmapbox/maps",
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fairführer verwendet deinen Standort, um Orte in deiner Nähe auf der Karte anzuzeigen und die Liste nachhaltiger Orte nach Entfernung zu sortieren (z. B. „in der Nähe von Lindau\"). Ohne Standortfreigabe funktioniert die App weiterhin – lediglich die Nähe-Sortierung ist deaktiviert."
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-image-picker",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "siemiatkowski"
        }
      ],
      "expo-build-properties"
    ]
  }
}
