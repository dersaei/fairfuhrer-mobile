+  for (let i = 0; i < key.length; i++) {
+    h ^= key.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  // Map to [0, 1). >>> 0 normalizes the int32 to uint32.
+  return (h >>> 0) / 0x100000000;
+}
