+  sightsCategoryIds: Set<number>,
+): boolean {
+  if (!place.Kategorie) return false;
+  return place.Kategorie.some(
+    (k) => k.Kategorie_id && sightsCategoryIds.has(k.Kategorie_id.id),
+  );
